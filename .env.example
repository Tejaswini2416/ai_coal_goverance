# ── Application ───────────────────────────────────────────────────────
APP_ENV=development
APP_SECRET_KEY=CHANGE_ME_32_CHAR_RANDOM_STRING_HERE
APP_DEBUG=true
APP_LOG_LEVEL=INFO

# ── JWT ───────────────────────────────────────────────────────────────
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=15
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7
JWT_ALGORITHM=HS256

# ── MongoDB 7.0+ ──────────────────────────────────────────────────────
MONGODB_URL=mongodb://localhost:27017/coal_governance

# ── Redis ─────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# ── MinIO / S3 ────────────────────────────────────────────────────────
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=CHANGE_ME_MINIO_SECRET
MINIO_BUCKET_DOCUMENTS=coal-documents
MINIO_BUCKET_EVIDENCE=coal-evidence
MINIO_USE_SSL=false
PRESIGNED_URL_EXPIRY_SECONDS=3600

# ── Celery ────────────────────────────────────────────────────────────
COMPLIANCE_MONITOR_CRON_HOUR=0
COMPLIANCE_MONITOR_CRON_MINUTE=30
PERMIT_EXPIRY_ALERT_DAYS=30,15,7,1

# ── Statutory Emergency SMS Alerts ────────────────────────────────────
SMS_PROVIDER_API_KEY=
SMS_SENDER_ID=COALGOV
MINISTRY_PHONE_NUMBER=+917842295449
INSPECTOR_PHONE_NUMBER=+918919912916

# External APIs
OPENAI_API_KEY="sk-test-dummy-key"
ANTHROPIC_API_KEY="sk-ant-test-dummy-key"
